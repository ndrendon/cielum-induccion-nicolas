      "item": [
        {
          "name": "Salud",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/salud",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
