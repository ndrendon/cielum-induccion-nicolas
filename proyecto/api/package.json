{
  "name": "proyecto-api",
  "version": "1.0.0",
  "description": "API REST del proyecto integrador (parte 1): clientes, productos y pedidos con Express y PostgreSQL",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "db:init": "node --env-file=.env db/init.js",
    "test": "node --env-file=.env --test test/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
