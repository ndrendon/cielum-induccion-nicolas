# Copia este archivo como .env y llena los valores que están vacíos.

# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL: la base del docker-compose.yml (contenedor proyecto-postgres),
# la misma que usa el modo Docker. Se prende con: docker compose up -d postgres
# PGPASSWORD es la misma de POSTGRES_PASSWORD en proyecto/.env
PGHOST=localhost
PGPORT=5433
PGDATABASE=proyecto
PGUSER=postgres
PGPASSWORD=

# Secreto para firmar los tokens JWT (mínimo 16 caracteres) y cuánto duran
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Dirección del frontend que puede usar la API (CORS)
CORS_ORIGIN=http://localhost:5173

# Zona horaria de las consultas a PostgreSQL, para que los pedidos nuevos queden
# con la fecha de Colombia y no con la fecha UTC
PGOPTIONS=-c timezone=America/Bogota

# Proyecto, parte 7: webhook de n8n que recibe cada pedido nuevo.
# En el modo local: http://localhost:5678/webhook/pedido-creado
# Si se deja vacío, la API no le avisa a n8n y todo lo demás funciona igual.
N8N_WEBHOOK_URL=
# El mismo N8N_WEBHOOK_SECRET de proyecto/.env (mínimo 16 caracteres). Va también en la credencial Secreto de la API de n8n
N8N_WEBHOOK_SECRET=
