# Copia este archivo como .env y llena los valores que están vacíos.

# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL (contenedor pg-induccion de Docker)
# La base proyecto se crea sola con: npm run db:init
PGHOST=localhost
PGPORT=5432
PGDATABASE=proyecto
PGUSER=postgres
PGPASSWORD=

# Secreto para firmar los tokens JWT (mínimo 16 caracteres) y cuánto duran
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Dirección del frontend que puede usar la API (CORS)
CORS_ORIGIN=http://localhost:5173
