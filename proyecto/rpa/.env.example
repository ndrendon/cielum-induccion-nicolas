# Copia este archivo como .env en esta misma carpeta (proyecto/rpa). El .env no se sube a Git.

# Dirección de la página en React: http://localhost:5173 en el modo local (npm run dev)
# o http://localhost:8080 en el modo Docker
FRONTEND_URL=http://localhost:5173

# Usuario de prueba con el que el bot inicia sesión (está en proyecto/api/db/02_datos.sql)
RPA_USUARIO=vendedor@cielum.test
RPA_CLAVE=
