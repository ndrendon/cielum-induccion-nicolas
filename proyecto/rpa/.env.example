# o http://localhost:5173 si corre con npm run dev
FRONTEND_URL=http://localhost:8080

# Usuario de prueba con el que el bot inicia sesión (está en proyecto/api/db/02_datos.sql)
RPA_USUARIO=vendedor@cielum.test
RPA_CLAVE=
