  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Se ejecuta antes de cada petición de la colección.",
          "// Si el access token ya venció, o le falta menos de 1 minuto, pide uno nuevo con el refresh token",
          "// y lo guarda en el entorno. Así no hay que renovarlo a mano cada hora.",
          "const url = pm.request.url.toString();",
          "if (url.includes('/oauth/v2/token')) {",
          "  return; // las peticiones de tokens no usan el access token",
          "}",
          "",
          "const refreshToken = pm.environment.get('refresh_token');",
          "const vence = Number(pm.environment.get('token_vence') || 0);",
          "const yaVencio = Date.now() > vence - 60 * 1000;",
          "",
          "if (!refreshToken) {",
          "  console.warn('No hay refresh_token en el entorno: corre primero \"Cambiar el grant token por tokens\".');",
          "  return;",
          "}",
          "",
          "if (yaVencio) {",
          "  pm.sendRequest(",
          "    {",
          "      url: pm.environment.get('accounts_url') + '/oauth/v2/token',",
          "      method: 'POST',",
          "      body: {",
          "        mode: 'urlencoded',",
          "        urlencoded: [",
          "          { key: 'refresh_token', value: refreshToken },",
          "          { key: 'client_id', value: pm.environment.get('client_id') },",
          "          { key: 'client_secret', value: pm.environment.get('client_secret') },",
          "          { key: 'grant_type', value: 'refresh_token' },",
          "        ],",
          "      },",
          "    },",
          "    (error, respuesta) => {",
          "      if (error) {",
          "        console.error('No se pudo renovar el access token:', error);",
          "        return;",
          "      }",
          "      const datos = respuesta.json();",
          "      if (!datos.access_token) {",
          "        console.error('Zoho no devolvió un access token nuevo:', datos);",
          "        return;",
          "      }",
          "      pm.environment.set('access_token', datos.access_token);",
          "      pm.environment.set('token_vence', String(Date.now() + datos.expires_in * 1000));",
          "      console.log('Access token renovado con el refresh token');",
          "    },",
          "  );",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Se ejecuta después de cada petición: si Zoho responde un error de token, lo explica en la consola",
          "if (pm.response.code === 401) {",
          "  console.warn('Zoho respondió 401: el access token no sirve. Revisa el entorno o vuelve a generar los tokens.');",
          "}"
        ]
      }
    }
  ],
