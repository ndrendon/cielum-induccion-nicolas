  "item": [
    {
      "name": "0. Tokens",
      "description": "Peticiones a Zoho Accounts para obtener y renovar los tokens de OAuth. No usan el access token.",
      "item": [
        {
          "name": "Cambiar el grant token por tokens",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{accounts_url}}/oauth/v2/token",
              "host": [
                "{{accounts_url}}"
              ],
              "path": [
                "oauth",
                "v2",
                "token"
              ]
            },
            "description": "Cambia el grant token que se generó en el Self Client (api-console.zoho.com, pestaña Generate Code) por un access token y un refresh token, y los guarda en el entorno. El grant token es de un solo uso y vence en pocos minutos.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "code",
                  "value": "{{grant_token}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Zoho devolvió el access token y el refresh token', () => {",
                  "  // Si el código ya se usó o venció, Zoho responde 200 pero con { \"error\": \"invalid_code\" }",
                  "  pm.expect(datos.error, 'Zoho respondió: ' + datos.error).to.be.undefined;",
                  "  pm.expect(datos).to.have.property('access_token');",
                  "  pm.expect(datos).to.have.property('refresh_token');",
                  "});",
                  "",
                  "if (datos.access_token) {",
                  "  pm.environment.set('access_token', datos.access_token);",
                  "  pm.environment.set('refresh_token', datos.refresh_token);",
                  "  // api_domain es el dominio de la API que le corresponde a la cuenta, según su data center",
                  "  pm.environment.set('api_domain', datos.api_domain);",
                  "  pm.environment.set('token_vence', String(Date.now() + datos.expires_in * 1000));",
                  "  // El grant token es de un solo uso: se borra para no volver a mandarlo",
                  "  pm.environment.set('grant_token', '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar el access token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{accounts_url}}/oauth/v2/token",
              "host": [
                "{{accounts_url}}"
              ],
              "path": [
                "oauth",
                "v2",
                "token"
              ]
            },
            "description": "Pide un access token nuevo con el refresh token. La colección ya lo hace sola antes de cada petición cuando el token venció; esta petición sirve para hacerlo a mano.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "refresh_token",
                  "value": "{{refresh_token}}",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "refresh_token",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Zoho devolvió un access token nuevo', () => {",
                  "  pm.expect(datos.error, 'Zoho respondió: ' + datos.error).to.be.undefined;",
                  "  pm.expect(datos).to.have.property('access_token');",
                  "  pm.expect(datos.expires_in).to.eql(3600);",
                  "});",
                  "",
                  "if (datos.access_token) {",
                  "  pm.environment.set('access_token', datos.access_token);",
                  "  pm.environment.set('token_vence', String(Date.now() + datos.expires_in * 1000));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Leads",
      "description": "Crear, consultar, actualizar, buscar y convertir un lead.",
      "item": [
        {
          "name": "Crear lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_domain}}/crm/v8/Leads",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "Leads"
              ]
            },
            "description": "Crea un lead de prueba. Con \"trigger\": [\"workflow\"] se ejecutan las reglas de flujo de trabajo, por ejemplo la que crea una tarea para los leads de origen Web.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": [\n    {\n      \"First_Name\": \"Prueba\",\n      \"Last_Name\": \"Postman\",\n      \"Company\": \"Empresa de Prueba Postman\",\n      \"Email\": \"{{lead_email}}\",\n      \"Phone\": \"3000000099\",\n      \"City\": \"Medellín\",\n      \"Origen_Cielum\": \"Web\"\n    }\n  ],\n  \"trigger\": [\n    \"workflow\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Zoho creó el lead (201)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  pm.expect(datos.data[0].code, datos.data[0].message).to.eql('SUCCESS');",
                  "  pm.expect(datos.data[0].details).to.have.property('id');",
                  "});",
                  "",
                  "// Se guarda el id para las siguientes peticiones",
                  "pm.collectionVariables.set('lead_id', datos.data[0].details.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar el lead",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_domain}}/crm/v8/Leads/{{lead_id}}",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "Leads",
                "{{lead_id}}"
              ]
            },
            "description": "Trae el lead creado por su id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "const lead = datos.data[0];",
                  "",
                  "pm.test('Zoho devolvió el lead (200)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(lead.id).to.eql(pm.collectionVariables.get('lead_id'));",
                  "});",
                  "",
                  "pm.test('El lead tiene los datos con los que se creó', () => {",
                  "  pm.expect(lead.Last_Name).to.eql('Postman');",
                  "  pm.expect(lead.Email).to.eql(pm.collectionVariables.get('lead_email'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar leads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_domain}}/crm/v8/Leads?fields=First_Name,Last_Name,Company,Email,Origen_Cielum&per_page=10",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "Leads"
              ],
              "query": [
                {
                  "key": "fields",
                  "value": "First_Name,Last_Name,Company,Email,Origen_Cielum"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Trae los primeros 10 leads. En la v8 el parámetro fields es obligatorio al listar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Zoho devolvió la lista de leads (200)', () => {",
                  "  // Si el módulo no tiene registros, Zoho responde 204 sin cuerpo",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const datos = pm.response.json();",
                  "  pm.test('Cada lead trae solo los campos pedidos en fields', () => {",
                  "    pm.expect(datos.data.length).to.be.at.most(10);",
                  "    pm.expect(datos.data[0]).to.have.property('Last_Name');",
                  "    pm.expect(datos.info).to.have.property('more_records');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar el lead",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_domain}}/crm/v8/Leads/{{lead_id}}",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "Leads",
                "{{lead_id}}"
              ]
            },
            "description": "Cambia la empresa y el teléfono del lead.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": [\n    {\n      \"Company\": \"Empresa de Prueba Postman (actualizada)\",\n      \"Phone\": \"3000000098\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Zoho actualizó el lead (200)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(datos.data[0].code, datos.data[0].message).to.eql('SUCCESS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar el lead por correo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_domain}}/crm/v8/Leads/search?email={{lead_email}}",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "Leads",
                "search"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{lead_email}}"
                }
              ]
            },
            "description": "Busca leads por correo con la Search API. También se puede buscar con criteria, phone o word."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La búsqueda respondió (200 o 204)', () => {",
                  "  // 204 quiere decir que no encontró nada. Justo después de crear un registro,",
                  "  // la búsqueda puede tardar unos segundos en encontrarlo.",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const ids = pm.response.json().data.map((lead) => lead.id);",
                  "  pm.test('La búsqueda encontró el lead creado', () => {",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('lead_id'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar con COQL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_domain}}/crm/v8/coql",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "coql"
              ]
            },
            "description": "Consulta los leads de origen Web con COQL. Necesita el scope ZohoCRM.coql.READ.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"select_query\": \"select First_Name, Last_Name, Company, Email, Origen_Cielum from Leads where Origen_Cielum = 'Web' limit 10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La consulta COQL respondió (200 o 204)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const datos = pm.response.json();",
                  "  pm.test('COQL trae los registros y la información de paginación', () => {",
                  "    pm.expect(datos.data).to.be.an('array');",
                  "    pm.expect(datos.info).to.have.property('count');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Convertir el lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_domain}}/crm/v8/Leads/{{lead_id}}/actions/convert",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "Leads",
                "{{lead_id}}",
                "actions",
                "convert"
              ]
            },
            "description": "Convierte el lead: Zoho crea un contacto y una cuenta con sus datos. El lead deja de existir.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": [\n    {\n      \"overwrite\": true,\n      \"notify_lead_owner\": false,\n      \"notify_new_entity_owner\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "const resultado = datos.data[0];",
                  "",
                  "pm.test('Zoho convirtió el lead (200)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(resultado.code, resultado.message).to.eql('SUCCESS');",
                  "  pm.expect(resultado.details.Contacts).to.have.property('id');",
                  "  pm.expect(resultado.details.Accounts).to.have.property('id');",
                  "});",
                  "",
                  "// La conversión crea un contacto y una cuenta: se guardan sus ids",
                  "pm.collectionVariables.set('contact_id', resultado.details.Contacts.id);",
                  "pm.collectionVariables.set('account_id', resultado.details.Accounts.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Tratos y función Deluge",
      "description": "Un trato nuevo dispara la regla con la función Deluge, que actualiza el contacto.",
      "item": [
        {
          "name": "Crear trato del contacto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_domain}}/crm/v8/Deals",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "Deals"
              ]
            },
            "description": "Crea un trato para el contacto y la cuenta de la conversión. Con \"trigger\": [\"workflow\"] se ejecuta la regla \"Actualizar contacto al crear trato\", que llama a la función Deluge.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": [\n    {\n      \"Deal_Name\": \"{{nombre_trato}}\",\n      \"Stage\": \"Qualification\",\n      \"Closing_Date\": \"{{fecha_cierre}}\",\n      \"Amount\": 1500000,\n      \"Contact_Name\": {\n        \"id\": \"{{contact_id}}\"\n      },\n      \"Account_Name\": {\n        \"id\": \"{{account_id}}\"\n      }\n    }\n  ],\n  \"trigger\": [\n    \"workflow\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La fecha de cierre del trato: 30 días después de hoy, en formato AAAA-MM-DD",
                  "const fecha = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('fecha_cierre', fecha.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "",
                  "pm.test('Zoho creó el trato (201)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  pm.expect(datos.data[0].code, datos.data[0].message).to.eql('SUCCESS');",
                  "  pm.expect(datos.data[0].details).to.have.property('id');",
                  "});",
                  "",
                  "// Se guarda el id para las siguientes peticiones",
                  "pm.collectionVariables.set('deal_id', datos.data[0].details.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver el contacto actualizado por la función",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_domain}}/crm/v8/Contacts/{{contact_id}}",
              "host": [
                "{{api_domain}}"
              ],
              "path": [
                "crm",
                "v8",
                "Contacts",
                "{{contact_id}}"
              ]
            },
            "description": "Trae el contacto y revisa que la función Deluge haya llenado su campo Ultimo_trato."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
