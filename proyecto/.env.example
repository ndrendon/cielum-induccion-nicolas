# Variables de docker-compose.yml.
# Copia este archivo como .env en esta misma carpeta (proyecto) y llena los valores vacíos.
# El .env no se sube a Git.

# Usuario y contraseña de PostgreSQL del contenedor proyecto-postgres.
# Es una base nueva, así que la contraseña la escoges tú.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Secreto para firmar los tokens JWT de la API (mínimo 16 caracteres).
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Contraseña del usuario sa de SQL Server. Debe tener mínimo 8 caracteres
# y mezclar mayúsculas, minúsculas, números y símbolos, o SQL Server no arranca.
MSSQL_SA_PASSWORD=

# Si alguna contraseña tiene el signo $, escríbela entre comillas simples, por ejemplo: 'Clave$2026'
