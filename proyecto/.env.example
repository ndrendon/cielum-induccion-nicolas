# Variables de docker-compose.yml.
# Copia este archivo como .env en esta misma carpeta (proyecto) y llena los valores vacíos.
# Se hace una sola vez: si lo vuelves a copiar encima del .env, se borran los valores.
# El .env no se sube a Git.

# Usuario y contraseña de PostgreSQL del contenedor proyecto-postgres, la base de los dos modos.
# La contraseña la escoges tú, y va también en PGPASSWORD de api/.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Secreto para firmar los tokens JWT de la API (mínimo 16 caracteres).
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Contraseña del usuario sa de SQL Server. Debe tener mínimo 8 caracteres
# y mezclar mayúsculas, minúsculas, números y símbolos, o SQL Server no arranca.
MSSQL_SA_PASSWORD=

# Parte 7 (n8n).
# Llave con la que n8n cifra las credenciales que guarda. Créala una sola vez y no la cambies:
# si cambia, n8n ya no puede leer las credenciales guardadas. Para crear una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=
# Secreto que la API manda en el encabezado X-Webhook-Secret cuando avisa a n8n de un pedido nuevo.
# Mínimo 16 caracteres. Es el mismo de N8N_WEBHOOK_SECRET en api/.env y de la credencial "Secreto de la API" en n8n.
N8N_WEBHOOK_SECRET=

# Si alguna contraseña tiene el signo $, escríbela entre comillas simples, por ejemplo: 'Clave$2026'
