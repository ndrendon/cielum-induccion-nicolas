{
  "info": {
    "name": "Día 08 · API del proyecto (pruebas)",
    "description": "Todas las rutas de la API del proyecto integrador, con pruebas del código de estado y de la estructura de cada respuesta.\n\nAntes de usarla:\n1. Importar los entornos local y docker de la carpeta entornos.\n2. Escoger un entorno arriba a la derecha (local o docker).\n3. Correr primero la carpeta 2. Login: guarda el token en el entorno.\n\nSe puede correr completa con Run collection, en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Este script es de la colección: se ejecuta después de CADA petición.",
          "// Las respuestas 204 no traen cuerpo; todas las demás deben ser JSON.",
          "if (pm.response.code !== 204) {",
          "  pm.test('La respuesta es JSON', () => {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "id_producto",
      "value": ""
    },
    {
      "key": "id_cliente",
      "value": ""
    },
    {
      "key": "email_nuevo",
      "value": ""
    },
    {
      "key": "id_pedido",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Salud",
      "item": [
        {
          "name": "Salud",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Trae el estado ok y la fecha', () => {",
                  "  const datos = pm.response.json();",
                  "  pm.expect(datos).to.have.all.keys('estado', 'fecha');",
                  "  pm.expect(datos.estado).to.eql('ok');",
                  "  pm.expect(Date.parse(datos.fecha)).to.not.be.NaN;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/salud",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "item": [
        {
          "name": "Login vendedor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Trae el token y los datos del usuario', () => {",
                  "  const datos = pm.response.json();",
                  "  pm.expect(datos).to.have.all.keys('token', 'usuario');",
                  "  pm.expect(datos.token).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(datos.usuario).to.have.all.keys('id_usuario', 'nombre', 'email', 'rol');",
                  "  pm.expect(datos.usuario.rol).to.eql('vendedor');",
                  "});",
                  "",
                  "// Guarda el token en el entorno para que las demás peticiones lo usen",
                  "pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendedor@cielum.test\",\n  \"password\": \"Vendedor2026*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Guarda el token en la variable token del entorno que esté escogido."
          }
