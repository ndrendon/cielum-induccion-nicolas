{
  "info": {
    "name": "Día 08 · Lote de productos (CSV)",
    "description": "Crea productos en lote con los datos del archivo datos/productos.csv.\n\nSe corre con el Collection Runner (o con Newman) escogiendo ese archivo como datos: cada fila del CSV es una vuelta (iteración), y en cada vuelta se hace login y se crea un producto con los valores de esa fila.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login vendedor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "",
              "pm.environment.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"vendedor@cielum.test\",\n  \"password\": \"Vendedor2026*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Crear producto con los datos del CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "",
              "// pm.iterationData tiene los valores de la fila del CSV de esta vuelta",
              "pm.test('Se creó con los datos de la fila del CSV', () => {",
              "  const producto = pm.response.json();",
              "  pm.expect(producto).to.have.all.keys(['id_producto', 'nombre', 'categoria', 'precio', 'stock']);",
              "  pm.expect(producto.nombre).to.eql(pm.iterationData.get('nombre'));",
              "  pm.expect(producto.categoria).to.eql(pm.iterationData.get('categoria'));",
              "  pm.expect(producto.precio).to.eql(Number(pm.iterationData.get('precio')));",
              "  pm.expect(producto.stock).to.eql(Number(pm.iterationData.get('stock')));",
              "});",
              "",
              "console.log(`Vuelta ${pm.info.iteration + 1}: se creó el producto ${pm.response.json().id_producto} - ${pm.response.json().nombre}`);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{nombre}}\",\n  \"categoria\": \"{{categoria}}\",\n  \"precio\": {{precio}},\n  \"stock\": {{stock}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "nombre, categoria, precio y stock son las columnas del CSV. Si se envía sola, sin el archivo de datos, responde 400 porque esas variables no existen."
      }
    }
  ]
}
