# Variables para correr los contenedores de los ejercicios intermedio y avanzado.
# Copia este archivo como .env en esta misma carpeta (semana-2/docker) y llena los valores vacíos.
# El .env no se sube a Git.

PORT=3000

# Desde un contenedor, localhost es el mismo contenedor.
# host.docker.internal es el computador, donde pg-induccion tiene publicado el puerto 5432.
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=proyecto
PGUSER=postgres
# La misma contraseña de PGPASSWORD del archivo proyecto/api/.env
PGPASSWORD=

# El mismo JWT_SECRET del archivo proyecto/api/.env
JWT_SECRET=
JWT_EXPIRES_IN=1h
